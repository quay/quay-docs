      </table>
    </section>
    <section id="createorgnotification-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST \
-H "Authorization: Bearer &lt;bearer_token&gt;" \
-H "Content-Type: application/json" \
--data '{
    "event": "quota_warning",
    "method": "email",
    "config": {},
    "eventConfig": {}
}' \
https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/notifications</codeblock>
    </section>
  </refbody>
</reference>

      </table>
    </section>
    <section id="createorgmirrorconfig-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json" \
  -d '{"external_registry_type": "quay", "external_registry_url": "https://quay.example.com", "external_namespace": "&lt;source_namespace&gt;", "robot_username": "&lt;orgname&gt;+&lt;robotname&gt;", "visibility": "private", "sync_interval": 3600, "sync_start_date": "2025-01-01T00:00:00Z", "is_enabled": true}' \
  https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/mirror</codeblock>
    </section>
  </refbody>
</reference>

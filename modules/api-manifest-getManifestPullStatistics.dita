    <section id="getmanifestpullstatistics-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">curl -X GET \
  "https://&lt;quay-server.example.com&gt;/api/v1/repository/&lt;organization&gt;/&lt;repository&gt;/manifest/sha256:&lt;manifest&gt;/pull_statistics" \
  -H "Authorization: &lt;bearer_token&gt;" \
  -H "Accept: application/json"</codeblock>

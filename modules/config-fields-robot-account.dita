<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="config-fields-robot-account">
  <title>Robot account configuration fields</title>
  <shortdesc>The following configuration fields control whether robot account creation and interaction is allowed globally in Red Hat Quay.</shortdesc>
  <refbody>
    <section>
      <table>
        <title>Robot account configuration fields</title>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="50*"/>
          <colspec colname="col_2" colwidth="16.6666*"/>
          <colspec colname="col_3" colwidth="33.3334*"/>
          <thead>
            <row>
              <entry>Field</entry>
              <entry>Type</entry>
              <entry>Description</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>ROBOTS_DISALLOW</b>
                </p>
              </entry>
              <entry>
                <p>Boolean</p>
              </entry>
              <entry>
                <p>When set to <codeph>True</codeph>, robot accounts are prevented from all interactions, as well as from being created
<!-- break --><b>Default</b>: <codeph>False</codeph></p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
      <p outputclass="title">
        <b>Robot account disallow example YAML</b>
      </p>
      <codeblock outputclass="language-yaml"># ...
ROBOTS_DISALLOW: true
# ...</codeblock>
    </section>
  </refbody>
  <related-links>
    <link href="https://docs.redhat.com/en/documentation/red_hat_quay/3.18/html-single/use_red_hat_quay/index#disabling-robot-account" format="html" scope="external">
      <linktext>Disabling robot accounts</linktext>
    </link>
  </related-links>
</reference>

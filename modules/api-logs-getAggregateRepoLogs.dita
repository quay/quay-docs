    <section id="getaggregaterepologs-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  "&lt;quay-server.example.com&gt;/api/v1/repository/&lt;repository_name&gt;/&lt;namespace&gt;/aggregatelogs?starttime=2024-01-01&amp;endtime=2024-06-18""</codeblock>
    </section>
  </refbody>
</reference>

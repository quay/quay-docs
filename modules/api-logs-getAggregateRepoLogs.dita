<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getaggregaterepologs">
  <title>getAggregateRepoLogs</title>
  <shortdesc>Returns the aggregated logs for the specified repository.</shortdesc>
  <refbody>
    <section id="getaggregaterepologs-get">
      <title>GET /api/v1/repository/{repository}/aggregatelogs</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:admin</b>)</p>
    </section>
    <section id="getaggregaterepologs-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="getaggregaterepologs-query-parameters">
      <title>Query parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>endtime</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Latest time for logs. Format: "%m/%d/%Y" in UTC.</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>starttime</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Earliest time for logs. Format: "%m/%d/%Y" in UTC.</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

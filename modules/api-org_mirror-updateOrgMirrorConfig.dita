    <section id="updateorgmirrorconfig-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json" \
  -d '{"is_enabled": true, "sync_interval": 7200}' \
  https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/mirror</codeblock>

                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="deleteinstalluser-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X DELETE -H "Authorization: Bearer &lt;bearer_token&gt;" "https://&lt;quay-server.example.com&gt;/api/v1/superuser/users/{username}"</codeblock>
    </section>
  </refbody>
</reference>

            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>query</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>The search query.</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>includeUsage</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Whether to include usage metadata</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>

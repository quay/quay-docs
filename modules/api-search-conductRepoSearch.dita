    <section id="conductreposearch-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET "https://quay-server.example.com/api/v1/find/repositories?query=&lt;repo_name&gt;&amp;page=1&amp;includeUsage=true" \
  -H "Authorization: Bearer &lt;bearer_token&gt;"</codeblock>

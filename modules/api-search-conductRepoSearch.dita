<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="conductreposearch">
  <title>conductRepoSearch</title>
  <shortdesc>Get a list of apps and repositories that match the specified query.</shortdesc>
  <refbody>
    <section id="conductreposearch-get">
      <title>GET /api/v1/find/repositories</title>
      <p>
        <b>Authorizations: </b>
      </p>
    </section>

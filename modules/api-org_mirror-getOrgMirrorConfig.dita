<reference id="getorgmirrorconfig">
  <title>getOrgMirrorConfig</title>
  <shortdesc>Get the organization-level mirror configuration.</shortdesc>
  <refbody>
    <section id="getorgmirrorconfig-get">
      <title>GET /api/v1/organization/{orgname}/mirror</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>org:admin</b>)</p>
    </section>

<reference id="validateproxycacheconfig">
  <title>validateProxyCacheConfig</title>
  <shortdesc>Validate Proxy Cache Config.</shortdesc>
  <refbody>
    <section id="validateproxycacheconfig-post">
      <title>POST /api/v1/organization/{orgname}/validateproxycache</title>
      <p>
        <b>Authorizations: </b>
      </p>
    </section>
    <section id="validateproxycacheconfig-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>orgname</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry/>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="validateproxycacheconfig-request-body-schema">
      <title>Request body schema (application/json)</title>
      <p>Proxy cache configuration for an organization</p>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>upstream_registry</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>Name of the upstream registry that is to be cached</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

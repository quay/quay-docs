    <section id="validateproxycacheconfig-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST "https://&lt;quay-server.example.com&gt;/api/v1/organization/{orgname}/validateproxycache" \
  -H "Authorization: Bearer &lt;access_token&gt;" \
  -H "Content-Type: application/json" \
  -d '{
        "upstream_registry": "&lt;upstream_registry&gt;"
        "upstream_registry_username": "your_robot_account_username"
        "upstream_registry_password": "your_robot_account_password"
      }'</codeblock>

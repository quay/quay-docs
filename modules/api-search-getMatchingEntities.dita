    <section id="getmatchingentities-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET "https://quay-server.example.com/api/v1/entities/&lt;prefix&gt;?includeOrgs=&lt;true_or_false&gt;&amp;includeTeams=&lt;true_or_false&gt;&amp;namespace=&lt;namespace&gt;" \
  -H "Authorization: Bearer &lt;bearer_token&gt;"</codeblock>
    </section>
  </refbody>
</reference>

<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getmatchingentities">
  <title>getMatchingEntities</title>
  <shortdesc>Get a list of entities that match the specified prefix.</shortdesc>
  <refbody>
    <section id="getmatchingentities-get">
      <title>GET /api/v1/entities/{prefix}</title>
      <p>
        <b>Authorizations: </b>
      </p>
    </section>
    <section id="getmatchingentities-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>prefix</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry/>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="getmatchingentities-query-parameters">
      <title>Query parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>includeOrgs</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Whether to include orgs names.</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>includeTeams</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Whether to include team names.</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>namespace</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Namespace to use when querying for org entities.</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

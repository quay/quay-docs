<reference id="updateorganizationprototypepermission">
  <title>updateOrganizationPrototypePermission</title>
  <shortdesc>Update the role of an existing permission prototype.</shortdesc>
  <refbody>
    <section id="updateorganizationprototypepermission-put">
      <title>PUT /api/v1/organization/{orgname}/prototypes/{prototypeid}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>org:admin</b>)</p>
    </section>

<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getuserrobotpermissions">
  <title>getUserRobotPermissions</title>
  <shortdesc>Returns the list of repository permissions for the user’s robot.</shortdesc>
  <refbody>
    <section id="getuserrobotpermissions-get">
      <title>GET /api/v1/user/robots/{robot_shortname}/permissions</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>user:admin</b>)</p>
    </section>
    <section id="getuserrobotpermissions-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>robot_shortname</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The short name for the robot, without any user or organization prefix</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

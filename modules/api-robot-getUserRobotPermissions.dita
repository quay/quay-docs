    <section id="getuserrobotpermissions-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  "https://quay-server.example.com/api/v1/user/robots/&lt;ROBOT_SHORTNAME&gt;/permissions"</codeblock>

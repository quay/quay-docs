<?xml version="1.0"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="creating-a-team-api">
  <title>Creating a team by using the API</title>
  <shortdesc>To create a team for an organization in Red Hat Quay, you can use the API. You can set the team name, repository access, and permission level.</shortdesc>
  <taskbody>
    <prereq>
      <ul>
        <li>You have created an organization.</li>
        <li>You have <xref href="https://docs.redhat.com/en/documentation/red_hat_quay/3.18/html-single/red_hat_quay_api_guide/index#creating-oauth-access-token" format="html" scope="external">Created an OAuth access token</xref>.</li>
      </ul>
    </prereq>
    <steps>
      <step>
        <cmd>Enter the following <xref href="https://docs.redhat.com/en/documentation/red_hat_quay/3.18/html-single/red_hat_quay_api_reference/index#updateorganizationteam" format="html" scope="external"><codeph>PUT /api/v1/organization/{orgname}/team/{teamname}</codeph></xref> command to create a team for your organization:
</cmd>
        <info>
          <codeblock outputclass="language-terminal">$ curl -k -X PUT -H 'Accept: application/json' -H 'Content-Type: application/json' -H "Authorization: Bearer &lt;bearer_token&gt;"  --data '{"role": "creator"}' https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;organization_name&gt;/team/&lt;team_name&gt;</codeblock>
          <p outputclass="title">
            <b>Example output</b>
          </p>
          <codeblock outputclass="language-terminal">{"name": "example_team", "description": "", "can_view": true, "role": "creator", "avatar": {"name": "example_team", "hash": "dec209fd7312a2284b689d4db3135e2846f27e0f40fa126776a0ce17366bc989", "color": "#e7ba52", "kind": "team"}, "new_team": true}</codeblock>
        </info>
      </step>
    </steps>
  </taskbody>
</task>

    <section id="getuserpermissions-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;access_token&gt;" \
  "https://quay-server.example.com/api/v1/repository/&lt;repository_path&gt;/permissions/user/&lt;username&gt;"</codeblock>

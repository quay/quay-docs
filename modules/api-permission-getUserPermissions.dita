<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getuserpermissions">
  <title>getUserPermissions</title>
  <shortdesc>Get the permission for the specified user.</shortdesc>
  <refbody>
    <section id="getuserpermissions-get">
      <title>GET /api/v1/repository/{repository}/permissions/user/{username}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:admin</b>)</p>
    </section>
    <section id="getuserpermissions-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>username</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The username of the user to which the permission applies</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

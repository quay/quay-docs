    <section id="postregistrysize-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST "https://quay-server.example.com/api/v1/superuser/registrysize/" \
  -H "Authorization: Bearer &lt;ACCESS_TOKEN&gt;" \
  -H "Content-Type: application/json" \
  -d '{
    "namespace": "&lt;namespace&gt;",

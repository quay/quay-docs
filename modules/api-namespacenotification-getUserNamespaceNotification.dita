    <section id="getusernamespacenotification-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
-H "Authorization: Bearer &lt;bearer_token&gt;" \
-H "Accept: application/json" \
https://&lt;quay-server.example.com&gt;/api/v1/user/namespacenotifications/&lt;uuid&gt;</codeblock>
    </section>

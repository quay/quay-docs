    </section>
    <section id="changeorganizationquotalimit-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT "https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/quota/&lt;quota_id&gt;/limit/&lt;limit_id&gt;" \
     -H "Authorization: Bearer &lt;access_token&gt;" \
     -H "Content-Type: application/json" \
     -d '{
           "type": "&lt;type&gt;",
           "threshold_percent": &lt;threshold_percent&gt;
         }'</codeblock>
    </section>
  </refbody>
</reference>

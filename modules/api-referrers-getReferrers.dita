<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getreferrers">
  <title>getReferrers</title>
  <shortdesc>List v2 API referrers of an image digest.</shortdesc>
  <refbody>
    <section id="getreferrers-get">
      <title>GET /v2/{organization_name}/{repository_name}/referrers/{digest}</title>
    </section>
    <section id="getreferrers-request-body-schema">
      <title>Request body schema (application/json)</title>
      <p>Referrers of an image digest.</p>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="25*"/>
          <colspec colname="col_2" colwidth="25*"/>
          <colspec colname="col_3" colwidth="25*"/>
          <colspec colname="col_4" colwidth="25*"/>
          <tbody>
            <row>
              <entry>
                <p>Type</p>
              </entry>
              <entry>
                <p>Name</p>
              </entry>
              <entry>
                <p>Description</p>
              </entry>
              <entry>
                <p>Schema</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>orgname</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The name of the organization</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>referrers</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>Looks up the OCI referrers of a manifest under a repository.</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
  </refbody>
</reference>

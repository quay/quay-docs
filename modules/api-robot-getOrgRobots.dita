    <section id="getorgrobots-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET -H "Authorization: Bearer &lt;bearer_token&gt;" "https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;organization_name&gt;/robots"</codeblock>
    </section>
  </refbody>
</reference>

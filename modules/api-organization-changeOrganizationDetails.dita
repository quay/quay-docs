<reference id="changeorganizationdetails">
  <title>changeOrganizationDetails</title>
  <shortdesc>Change the details for the specified organization.</shortdesc>
  <refbody>
    <section id="changeorganizationdetails-put">
      <title>PUT /api/v1/organization/{orgname}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>org:admin</b>)</p>
    </section>

                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="changerepovisibility-example-command">
      <title>Example Command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST \
  -H "Authorization: Bearer &lt;ACCESS_TOKEN&gt;" \
  -H "Content-Type: application/json" \
  -d '{
        "visibility": "private"
      }' \
  "https://quay-server.example.com/api/v1/repository/&lt;NAMESPACE&gt;/&lt;REPO_NAME&gt;/changevisibility"</codeblock>
    </section>
  </refbody>
</reference>

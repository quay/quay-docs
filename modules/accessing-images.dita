<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="accessing-images_{context}">
  <title>Accessing images</title>
  <shortdesc>To access Red Hat Quay and Clair images for standalone upgrades, pull from registry.redhat.io or registry.access.redhat.com and configure authentication as described in Red Hat Container Registry Authentication.</shortdesc>
  <refbody>
    <section>
      <p>Red Hat Quay images from version 3.4.0 and later are available from registry.redhat.io and registry.access.redhat.com. Configure authentication before pulling images.</p>
    </section>
    <section id="upgrade-to-producty-from-3_17_z">
      <title>Upgrade to v3.18.0 from 3.17.z</title>
      <ul>
        <li><b>Quay:</b> registry.redhat.io/quay/quay-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:4.9</li>
        <li><b>PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
        <li><b>Redis:</b> registry.redhat.io/rhel9/redis-6:latest</li>
        <li><b>Clair-PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
      </ul>
    </section>
    <section id="upgrade-to-producty-from-3_16_z">
      <title>Upgrade to v3.18.0 from 3.16.z</title>
      <ul>
        <li><b>Quay:</b> registry.redhat.io/quay/quay-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:4.9</li>
        <li><b>PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
        <li><b>Redis:</b> registry.redhat.io/rhel9/redis-6:latest</li>
        <li><b>Clair-PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
      </ul>
    </section>
    <section id="upgrade-to-producty-from-3_15_z">
      <title>Upgrade to v3.18.0 from 3.15.z</title>
      <ul>
        <li><b>Quay:</b> registry.redhat.io/quay/quay-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:v3.18.0</li>
        <li><b>Clair:</b> registry.redhat.io/quay/clair-rhel9:4.9</li>
        <li><b>PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
        <li><b>Redis:</b> registry.redhat.io/rhel9/redis-6:latest</li>
        <li><b>Clair-PostgreSQL:</b> registry.redhat.io/rhel9/postgresql-15</li>
      </ul>
    </section>
  </refbody>
</reference>

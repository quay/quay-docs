            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>201</p>
              </entry>
              <entry>
                <p>Successful invocation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>401</p>
              </entry>
              <entry>
                <p>Session required</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="createorgrobotfederation-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST "https://quay-server.example.com/api/v1/organization/{orgname}/robots/{robot_shortname}/federation" \
  -H "Authorization: Bearer &lt;your_access_token&gt;" \
  -H "Content-Type: application/json" \
  -d '[
    {
      "issuer": "https://keycloak-auth-realm.quayadmin.org/realms/quayrealm",
      "subject": "449e14f8-9eb5-4d59-a63e-b7a77c75f770"
    }
  ]'</codeblock>
    </section>
  </refbody>
</reference>

<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getapptoken">
  <title>getAppToken</title>
  <shortdesc>Returns a specific app token for the user.</shortdesc>
  <refbody>
    <section id="getapptoken-get">
      <title>GET /api/v1/user/apptoken/{token_uuid}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>user:admin</b>)</p>
    </section>
    <section id="getapptoken-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>token_uuid</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The uuid of the app specific token</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="getapptoken-responses">
      <title>Responses</title>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>HTTP Code</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>200</p>
              </entry>
              <entry>
                <p>Successful invocation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>401</p>
              </entry>
              <entry>
                <p>Session required</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>404</p>
              </entry>
              <entry>
                <p>Not found</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="getapptoken-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;access_token&gt;" \
  "http://quay-server.example.com/api/v1/user/apptoken/&lt;token_uuid&gt;"</codeblock>
    </section>
  </refbody>
</reference>

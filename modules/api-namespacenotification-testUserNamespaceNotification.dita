          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>uuid</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The uuid of the notification</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>

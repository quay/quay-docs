<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="testusernamespacenotification">
  <title>testUserNamespaceNotification</title>
  <shortdesc>Test User Namespace Notification.</shortdesc>
  <refbody>
    <section id="testusernamespacenotification-post">
      <title>POST /api/v1/user/namespacenotifications/{uuid}/test</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>user:admin</b>)</p>
    </section>

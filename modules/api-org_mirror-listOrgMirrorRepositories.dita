<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="listorgmirrorrepositories">
  <title>listOrgMirrorRepositories</title>
  <shortdesc>List all discovered repositories from source namespace.</shortdesc>
  <refbody>
    <section>
      <pre>Query Parameters:
    page (int): Page number, default 1
    limit (int): Items per page, default 100, max 500</pre>
      <pre>Returns:
    JSON object with:
        - repositories: List of repository objects
        - page: Current page number
        - limit: Items per page
        - total: Total number of matching repositories
        - has_next: Whether there are more pages</pre>
    </section>
    <section id="listorgmirrorrepositories-get">
      <title>GET /api/v1/organization/{orgname}/mirror/repositories</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>org:admin</b>)</p>
    </section>

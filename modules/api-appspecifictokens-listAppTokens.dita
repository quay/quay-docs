<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="listapptokens">
  <title>listAppTokens</title>
  <shortdesc>Lists the app specific tokens for the user.</shortdesc>
  <refbody>
    <section id="listapptokens-get">
      <title>GET /api/v1/user/apptoken</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>user:admin</b>)</p>
    </section>
    <section id="listapptokens-query-parameters">
      <title>Query parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>expiring</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>If true, only returns those tokens expiring soon</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="listapptokens-responses">
      <title>Responses</title>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>HTTP Code</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>200</p>
              </entry>
              <entry>
                <p>Successful invocation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>401</p>
              </entry>
              <entry>
                <p>Session required</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>404</p>
              </entry>
              <entry>
                <p>Not found</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="listapptokens-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;access_token&gt;" \
  "http://quay-server.example.com/api/v1/user/apptoken"</codeblock>
    </section>
  </refbody>
</reference>

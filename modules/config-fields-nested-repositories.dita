<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="config-fields-nested-repositories">
  <title>Nested repositories configuration fields</title>
  <shortdesc>Support for nested repository path names has been added by the <codeph>FEATURE_EXTENDED_REPOSITORY_NAMES</codeph> property. This optional configuration is added to the <codeph>config.yaml</codeph> by default. Enablement allows the use of <codeph>/</codeph> in repository names.</shortdesc>
  <refbody>
    <section>
      <table>
        <title>Nested repositories configuration fields</title>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="50*"/>
          <colspec colname="col_2" colwidth="16.6666*"/>
          <colspec colname="col_3" colwidth="33.3334*"/>
          <thead>
            <row>
              <entry>Field</entry>
              <entry>Type</entry>
              <entry>Description</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>FEATURE_EXTENDED_REPOSITORY_NAMES</b>
                </p>
              </entry>
              <entry>
                <p>Boolean</p>
              </entry>
              <entry>
                <p>Enable support for nested repositories <b>Default:</b> True</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
      <p outputclass="title">
        <b>Nested repositories example YAML</b>
      </p>
      <codeblock outputclass="language-yaml"># ...
FEATURE_EXTENDED_REPOSITORY_NAMES: true
# ...</codeblock>
    </section>
  </refbody>
</reference>

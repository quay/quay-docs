    <section id="syncorgmirrornow-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/mirror/sync-now</codeblock>

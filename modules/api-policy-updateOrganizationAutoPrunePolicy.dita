      </table>
    </section>
    <section id="updateorganizationautoprunepolicy-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT   -H "Authorization: Bearer &lt;bearer_token&gt;"   -H "Content-Type: application/json"   -d '{
    "method": "creation_date",
    "value": "4d",
    "tagPattern": "^v*",
    "tagPatternMatches": true
  }'   "&lt;quay-server.example.com&gt;/api/v1/organization/&lt;organization_name&gt;/autoprunepolicy/&lt;uuid&gt;"</codeblock>
    </section>
  </refbody>
</reference>

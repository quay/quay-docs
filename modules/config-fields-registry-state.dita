<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="config-fields-registry-state">
  <title>Registry state and system behavior configuration fields</title>
  <shortdesc>The following configuration fields control Red Hat Quay registry operational state, including read-only mode and webhook hostname restrictions.</shortdesc>
  <refbody>
    <section>
      <table>
        <title>Registry state and system behavior configuration fields</title>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="50*"/>
          <colspec colname="col_2" colwidth="16.6666*"/>
          <colspec colname="col_3" colwidth="33.3334*"/>
          <thead>
            <row>
              <entry>Field</entry>
              <entry>Type</entry>
              <entry>Description</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>REGISTRY_STATE</b>
                </p>
              </entry>
              <entry>
                <p>String</p>
              </entry>
              <entry>
                <p>The state of the registry. <b>Values:</b><codeph>normal</codeph> or <codeph>read-only</codeph></p>
              </entry>
            </row>
            <row>
              <entry>
                <p>
                  <b>WEBHOOK_HOSTNAME_BLACKLIST</b>
                </p>
              </entry>
              <entry>
                <p>Array of String</p>
              </entry>
              <entry>
                <p>The set of hostnames to disallow from webhooks when validating, beyond localhost</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
      <p outputclass="title">
        <b>Registry state and system behavior example YAML</b>
      </p>
      <codeblock outputclass="language-yaml"># ...
REGISTRY_STATE: normal
WEBHOOK_HOSTNAME_BLACKLIST:
  - "169.254.169.254"
  - "internal.example.com"
  - "127.0.0.2"
# ...</codeblock>
    </section>
  </refbody>
  <related-links>
    <link href="https://docs.redhat.com/en/documentation/red_hat_quay/3.18/html-single/manage_red_hat_quay/index#optional-enabling-read-only-mode-backup-restore-standalone" format="html" scope="external">
      <linktext>Enabling read-only mode for Red Hat Quay</linktext>
    </link>
  </related-links>
</reference>

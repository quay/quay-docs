              </entry>
              <entry>
                <p>integer</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>disabled</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>If false, only enabled users will be returned.</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

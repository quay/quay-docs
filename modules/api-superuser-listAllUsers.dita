<reference id="listallusers">
  <title>listAllUsers</title>
  <shortdesc>Returns a list of all users in the system.</shortdesc>
  <refbody>
    <section id="listallusers-get">
      <title>GET /api/v1/superuser/users/</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>super:user</b>)</p>
    </section>

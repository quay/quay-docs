                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="syncnow-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST "https://&lt;quay-server.example.com&gt;/api/v1/repository/&lt;namespace&gt;/&lt;repo&gt;/mirror/sync-now" \
     -H "Authorization: Bearer &lt;access_token&gt;"</codeblock>
    </section>
  </refbody>
</reference>

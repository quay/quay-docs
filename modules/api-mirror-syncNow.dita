<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="syncnow">
  <title>syncNow</title>
  <shortdesc>Update the sync_status for a given Repository’s mirroring configuration.</shortdesc>
  <refbody>
    <section id="syncnow-post">
      <title>POST /api/v1/repository/{repository}/mirror/sync-now</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:admin</b>)</p>
    </section>
    <section id="syncnow-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

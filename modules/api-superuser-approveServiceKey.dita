    <section id="approveservicekey-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X POST \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Content-Type: application/json" \
  -d '{
        "notes": "&lt;approval_notes&gt;"
      }' \
  "https://&lt;quay_server&gt;/api/v1/superuser/approvedkeys/&lt;kid&gt;"</codeblock>
    </section>
  </refbody>

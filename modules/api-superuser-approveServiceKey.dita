          <thead>
            <row>
              <entry>HTTP Code</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>201</p>
              </entry>
              <entry>
                <p>Successful creation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>

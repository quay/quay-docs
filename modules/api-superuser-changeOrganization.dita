    <section id="changeorganization-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Content-Type: application/json" \
  -d '{
        "name": "&lt;new_organization_name&gt;"
      }' \
  "https://&lt;quay_server&gt;/api/v1/superuser/organizations/&lt;organization_name&gt;"</codeblock>

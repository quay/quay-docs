<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="updateorgimmutabilitypolicy">
  <title>updateOrgImmutabilityPolicy</title>
  <shortdesc>Update Org Immutability Policy.</shortdesc>
  <refbody>
    <section id="updateorgimmutabilitypolicy-put">
      <title>PUT /api/v1/organization/{orgname}/immutabilitypolicy/{policy_uuid}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>org:admin</b>)</p>
    </section>
    <section id="updateorgimmutabilitypolicy-request-body-schema">
      <title>Request body schema (application/json)</title>
      <p>The immutability policy configuration</p>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>tagPattern</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>Regex pattern to match tag names</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>
                  <b>tagPatternMatches</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>If true, matching tags are immutable. If false, non-matching tags are immutable.</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="updateorgimmutabilitypolicy-responses">
      <title>Responses</title>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>HTTP Code</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>200</p>
              </entry>
              <entry>
                <p>Successful invocation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>401</p>
              </entry>
              <entry>
                <p>Session required</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>404</p>
              </entry>
              <entry>
                <p>Not found</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="updateorgimmutabilitypolicy-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT "https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/immutabilitypolicy/&lt;policy_uuid&gt;" \
  -H "Authorization: Bearer &lt;access_token&gt;" \
  -H "Content-Type: application/json" \
  -d '{"tagPattern": ".*", "tagPatternMatches": true}'</codeblock>
    </section>
  </refbody>
</reference>

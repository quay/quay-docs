    </section>
    <section id="getregistrycapabilities-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  "https://quay-server.example.com/api/v1/registry/capabilities" \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json"</codeblock>

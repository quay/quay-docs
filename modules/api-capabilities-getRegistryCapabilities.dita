<reference id="getregistrycapabilities">
  <title>getRegistryCapabilities</title>
  <shortdesc>Get registry capabilities.</shortdesc>
  <refbody>
    <section>
      <p>Returns information about supported registry features including sparse manifest support and required architectures.</p>
    </section>
    <section id="getregistrycapabilities-get">
      <title>GET /api/v1/registry/capabilities</title>
      <p>
        <b>Authorizations: </b>
      </p>
    </section>

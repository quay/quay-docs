<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="updatebuildtrigger">
  <title>updateBuildTrigger</title>
  <shortdesc>Updates the specified build trigger.</shortdesc>
  <refbody>
    <section id="updatebuildtrigger-put">
      <title>PUT /api/v1/repository/{repository}/trigger/{trigger_uuid}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:admin</b>)</p>
    </section>
    <section id="updatebuildtrigger-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>trigger_uuid</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The UUID of the build trigger</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="updatebuildtrigger-request-body-schema">
      <title>Request body schema (application/json)</title>
      <p>Options for updating a build trigger</p>
      <table>
        <tgroup cols="3">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <thead>
            <row>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>
                  <b>enabled</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>Whether the build trigger is enabled</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

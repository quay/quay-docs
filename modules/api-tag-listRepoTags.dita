              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>200</p>
              </entry>
              <entry>
                <p>Successful invocation</p>
              </entry>
              <entry/>
            </row>
            <row>
              <entry>
                <p>400</p>
              </entry>
              <entry>
                <p>Bad Request</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>401</p>
              </entry>
              <entry>
                <p>Session required</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>404</p>
              </entry>
              <entry>
                <p>Not found</p>
              </entry>

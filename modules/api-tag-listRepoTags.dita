                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="listrepotags-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  https://&lt;quay-server.example.com&gt;/api/v1/repository/&lt;namespace&gt;/&lt;repository_name&gt;/tag/</codeblock>
    </section>
  </refbody>
</reference>

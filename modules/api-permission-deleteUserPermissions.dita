<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="deleteuserpermissions">
  <title>deleteUserPermissions</title>
  <shortdesc>Delete the permission for the user.</shortdesc>
  <refbody>
    <section id="deleteuserpermissions-delete">
      <title>DELETE /api/v1/repository/{repository}/permissions/user/{username}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:admin</b>)</p>
    </section>
    <section id="deleteuserpermissions-path-parameters">

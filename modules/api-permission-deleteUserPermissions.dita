  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  https://&lt;quay-server.example.com&gt;/api/v1/repository/&lt;namespace&gt;/&lt;repository&gt;/permissions/user/&lt;username&gt;</codeblock>

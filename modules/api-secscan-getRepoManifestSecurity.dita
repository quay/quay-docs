<reference id="getrepomanifestsecurity">
  <title>getRepoManifestSecurity</title>
  <shortdesc>Get Repo Manifest Security.</shortdesc>
  <refbody>
    <section id="getrepomanifestsecurity-get">
      <title>GET /api/v1/repository/{repository}/manifest/{manifestref}/security</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>repo:read</b>)</p>
    </section>
    <section id="getrepomanifestsecurity-path-parameters">
      <title>Path parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>repository</b>
                </p>
                <p>
                  <i>required</i>
                </p>
              </entry>
              <entry>
                <p>The full path of the repository. e.g. namespace/name</p>
              </entry>
              <entry>
                <p>string</p>
              </entry>
            </row>
            <row>
              <entry>
                <p>path</p>
              </entry>
              <entry>
                <p>
                  <b>manifestref</b>
                </p>
                <p>
                  <i>required</i>
                </p>

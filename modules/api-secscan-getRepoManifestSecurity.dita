    <section id="getrepomanifestsecurity-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  -H "Authorization: Bearer &lt;bearer_token&gt;" \
  -H "Accept: application/json" \
  "https://quay-server.example.com/api/v1/repository/&lt;namespace&gt;/&lt;repository&gt;/manifest/&lt;manifest_digest&gt;/security?vulnerabilities=&lt;true_or_false&gt;"</codeblock>

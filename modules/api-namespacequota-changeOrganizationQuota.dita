    <section id="changeorganizationquota-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X PUT "https://&lt;quay-server.example.com&gt;/api/v1/organization/&lt;orgname&gt;/quota/&lt;quota_id&gt;" \
     -H "Authorization: Bearer &lt;access_token&gt;" \
     -H "Content-Type: application/json" \
     -d '{
         "limit_bytes": &lt;limit_in_bytes&gt;
     }'</codeblock>
    </section>

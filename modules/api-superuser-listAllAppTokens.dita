    </section>
    <section id="listallapptokens-example-command">
      <title>Example command</title>
      <p outputclass="title">
        <b>Example: List all app-specific tokens</b>
      </p>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  "https://quay-server.example.com/api/v1/superuser/apptokens" \
  -H "Authorization: Bearer &lt;superuser_access_token&gt;" \
  -H "Accept: application/json"</codeblock>
      <p outputclass="title">
        <b>Example: List app-specific tokens expiring soon</b>
      </p>
      <codeblock outputclass="language-terminal">$ curl -X GET \
  "https://quay-server.example.com/api/v1/superuser/apptokens?expiring=true" \
  -H "Authorization: Bearer &lt;superuser_access_token&gt;" \
  -H "Accept: application/json"</codeblock>
    </section>
  </refbody>
</reference>

<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="listallapptokens">
  <title>listAllAppTokens</title>
  <shortdesc>Returns a list of all app specific tokens in the system.</shortdesc>
  <refbody>
    <section>
      <pre>This endpoint is for system-wide auditing by superusers and global read-only superusers.</pre>
    </section>
    <section id="listallapptokens-get">
      <title>GET /api/v1/superuser/apptokens</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>super:user</b>)</p>
    </section>
    <section id="listallapptokens-query-parameters">
      <title>Query parameters</title>
      <table>
        <tgroup cols="4">
          <colspec colname="col_1" colwidth="*"/>
          <colspec colname="col_2" colwidth="*"/>
          <colspec colname="col_3" colwidth="*"/>
          <colspec colname="col_4" colwidth="*"/>
          <thead>
            <row>
              <entry>Type</entry>
              <entry>Name</entry>
              <entry>Description</entry>
              <entry>Schema</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>
                <p>query</p>
              </entry>
              <entry>
                <p>
                  <b>expiring</b>
                </p>
                <p>
                  <i>optional</i>
                </p>
              </entry>
              <entry>
                <p>If true, only returns those tokens expiring soon</p>
              </entry>
              <entry>
                <p>boolean</p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

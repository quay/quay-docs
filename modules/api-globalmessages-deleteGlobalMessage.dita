<reference id="deleteglobalmessage">
  <title>deleteGlobalMessage</title>
  <shortdesc>Delete a message.</shortdesc>
  <refbody>
    <section id="deleteglobalmessage-delete">
      <title>DELETE /api/v1/message/{uuid}</title>
      <p><b>Authorizations: </b>oauth2_implicit (<b>super:user</b>)</p>
    </section>

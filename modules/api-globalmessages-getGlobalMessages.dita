                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>403</p>
              </entry>
              <entry>
                <p>Unauthorized access</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
            <row>
              <entry>
                <p>404</p>
              </entry>
              <entry>
                <p>Not found</p>
              </entry>
              <entry>
                <p>
                  <xref href="#_apierror">ApiError</xref>
                </p>
              </entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="getglobalmessages-example-command">
      <title>Example command</title>
      <codeblock outputclass="language-terminal">$ curl -X GET "https://&lt;quay-server.example.com&gt;/api/v1/messages" \
    -H "Authorization: Bearer &lt;access_token&gt;"</codeblock>
    </section>
  </refbody>

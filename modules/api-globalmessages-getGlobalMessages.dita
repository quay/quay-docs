<?xml version="1.0"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getglobalmessages">
  <title>getGlobalMessages</title>
  <shortdesc>Return a super users messages.</shortdesc>

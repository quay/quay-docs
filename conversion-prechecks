#!/usr/bin/env bash
#
# conversion-prechecks - Wrapper for AsciiDoc pre-conversion validation
#
# Run from repository root:
#   ./conversion-prechecks                  # Check quay navigation (all categories)
#   ./conversion-prechecks quay             # Check quay navigation
#   ./conversion-prechecks <category>       # Check one quay category map
#   ./conversion-prechecks --all            # Check all products
#
# Log files are written to logs/

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec bash "$SCRIPT_DIR/scripts/navmap/conversion-prechecks.sh" "$@"
